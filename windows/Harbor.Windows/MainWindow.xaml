<Window
    x:Class="Harbor.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:Harbor.Desktop"
    Title="Harbor">
  <Grid x:Name="Root" Background="{ThemeResource HarborBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid x:Name="TitleBar" Height="32" Padding="16,0,140,0" IsHitTestVisible="False">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="Harbor" FontSize="12" Foreground="{ThemeResource HarborMutedBrush}" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SidebarColumn" Width="240" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid Background="{ThemeResource HarborSidebarBrush}" Padding="14,16,14,16" RowSpacing="14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="14,10,0,8">
          <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
            <local:HarborMarkView Width="34" Height="34" />
            <StackPanel>
              <TextBlock Text="Harbor" FontFamily="{StaticResource HarborUIFont}" FontSize="25" FontWeight="SemiBold" Foreground="{ThemeResource HarborTextBrush}" />
              <TextBlock Text="SSH WORKSPACE" FontFamily="{StaticResource HarborUIFont}" FontSize="8" CharacterSpacing="170" Foreground="{ThemeResource HarborMutedBrush}" />
            </StackPanel>
          </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
          <Border x:Name="NavigationHighlight" Height="42" VerticalAlignment="Top" CornerRadius="8" Background="{ThemeResource HarborSelectionBrush}" IsHitTestVisible="False">
            <Border.RenderTransform><TranslateTransform x:Name="NavigationHighlightOffset" /></Border.RenderTransform>
          </Border>
          <StackPanel x:Name="NavigationItems" Spacing="6" />
        </Grid>
        <Grid Grid.Row="2" RowSpacing="4">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid x:Name="SidebarSearchPanel" Height="0" Opacity="0" Visibility="Collapsed" SizeChanged="SidebarSearchPanel_SizeChanged">
            <AutoSuggestBox x:Name="SidebarSearch" Height="36" MinHeight="0" VerticalAlignment="Top" PlaceholderText="Search connections" TextChanged="SidebarSearch_TextChanged" KeyDown="SidebarSearch_KeyDown">
              <AutoSuggestBox.QueryIcon><SymbolIcon Symbol="Find" /></AutoSuggestBox.QueryIcon>
            </AutoSuggestBox>
          </Grid>
          <Grid x:Name="SidebarLibraryViewport" Grid.Row="1">
          <ScrollViewer x:Name="LibraryScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" Background="Transparent">
            <StackPanel x:Name="SidebarHosts" Spacing="6" Background="Transparent" />
          </ScrollViewer>
          <Border x:Name="StickyGroupHeader" Background="{ThemeResource HarborSidebarBrush}" Padding="0,0,0,6" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed">
            <Border.RenderTransform><TranslateTransform x:Name="StickyGroupHeaderOffset" /></Border.RenderTransform>
          </Border>
          <Border x:Name="SidebarSelectionRectangle" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False" BorderBrush="{ThemeResource HarborAccentBrush}" Background="{ThemeResource HarborSelectionBrush}" BorderThickness="1" CornerRadius="2">
            <Border.RenderTransform><TranslateTransform x:Name="SidebarSelectionOffset" /></Border.RenderTransform>
          </Border>
          </Grid>
        </Grid>
        <StackPanel Grid.Row="3" Spacing="12">
          <Button x:Name="NewConnectionButton" HorizontalAlignment="Stretch" CornerRadius="9" Style="{StaticResource HarborActionButtonStyle}" Padding="14,12" Click="NewConnection_Click">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <FontIcon Glyph="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Width="18" Height="18" />
              <TextBlock Text="New connection" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Grid>
            <Button x:Name="SettingsButton" Style="{StaticResource HarborIconButtonStyle}" Click="Settings_Click" AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings  Ctrl+,"><FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Width="18" Height="18" /></Button>
            <TextBlock x:Name="SidebarVersion" FontSize="10" Foreground="{ThemeResource HarborMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" IsHitTestVisible="False" />
          </Grid>
        </StackPanel>
      </Grid>
      <Grid Grid.Column="1" Padding="30,20,30,24" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" />
        <Grid x:Name="PageLayers" Grid.Row="1" />
      </Grid>
    </Grid>
  </Grid>
</Window>
